@{
    Layout = null;
    ViewBag.Title = "PantallaDeFichaje";
    var forceTvMode = ViewBag.ForceTvMode != null && (bool)ViewBag.ForceTvMode;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewBag.Title</title>

    @Styles.Render("~/Content/css")

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

    <link href="@Url.Content("~/Content/dashboard/dashboard.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/dashboard/dashboard-tv.css")" rel="stylesheet" />

    <script>
    (function () {
        function setTvViewportHeight() {
            document.documentElement.style.setProperty('--tv-vh', (window.innerHeight * 0.01) + 'px');
        }

        var forceTv = '@forceTvMode'.toLowerCase() === 'true';

        if (forceTv) {
            document.documentElement.classList.add('tv-mode');
            setTvViewportHeight();

            window.addEventListener('resize', setTvViewportHeight);
            window.addEventListener('orientationchange', setTvViewportHeight);
        }
    })();
    </script>

</head>

<body class="dashboard-body">
    <div class="container-fluid dashboard-shell">

        <!-- ENCABEZADO -->
        <div class="dashboard-top-wrap">
            <div class="dashboard-panel topbar-panel">
                <div class="row g-2 align-items-center topbar-row">

                    <div class="col-12 col-lg-4 topbar-col topbar-left">
                        <div class="brand-box d-flex align-items-center gap-3">
                            <img class="logo" src="@Url.Content("~/Content/img/logo-hdb.png")" alt="Logo Hospital" />
                            <div class="brand-text">
                                <div class="small-title">TABLERO INFORMATIVO</div>
                                <div class="big-title">Hospital De Tercer Nivel De</div>
                                <div class="big-title">Referencia Daniel Bracamonte</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-4 topbar-col topbar-center">
                        <div class="center-title-wrap text-center">
                            <div class="center-title">DISPONIBILIDAD DE FICHAS</div>
                            <div class="center-subtitle">CONSULTORIOS POR ESPECIALIDAD</div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-4 topbar-col topbar-right">
                        <div class="right-box d-flex flex-column align-items-lg-end align-items-center gap-2">
                            <div class="clock-card">
                                <div id="date" class="date-text">—</div>
                                <div id="clock" class="clock-text">--:--:--</div>
                            </div>
                            <div id="conn" class="conn-badge on">Conectado ✓</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- CONTENIDO PRINCIPAL -->
        <div class="dashboard-main-wrap">
            <div class="row g-2 h-100 dashboard-main-row">

                <!-- PANEL IZQUIERDO -->
                <div class="col-12 col-lg-8 col-xl-9 d-flex main-left-col">
                    <section class="dashboard-panel content-panel flex-fill cards-wrap">
                        <div class="section-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <div class="section-title">ÁREAS / SERVICIOS</div>
                                <div class="section-subtitle">Doctor titular · Horario · Disponibles</div>
                            </div>

                            <div id="syncBadge" class="section-badge">
                                Actualización automática
                            </div>
                        </div>

                        <div class="cards-body">
                            <div id="cards" class="cards-list"></div>
                        </div>
                    </section>
                </div>

                <!-- PANEL DERECHO -->
                <div class="col-12 col-lg-4 col-xl-3 d-flex main-right-col">
                    <aside class="dashboard-panel side-panel flex-fill">

                        <div class="side-top">
                            <div class="panel-title">GUÍA DE COLORES</div>

                            <div class="legend-row">
                                <div class="legend-left">
                                    <span class="dot green"></span>
                                    <span class="legend-text">Disponibles</span>
                                </div>
                                <span class="pill-badge">6+</span>
                            </div>

                            <div class="legend-row">
                                <div class="legend-left">
                                    <span class="dot yellow"></span>
                                    <span class="legend-text">Pocas</span>
                                </div>
                                <span class="pill-badge">1–5</span>
                            </div>

                            <div class="legend-row no-border">
                                <div class="legend-left">
                                    <span class="dot red"></span>
                                    <span class="legend-text">Agotado</span>
                                </div>
                                <span class="pill-badge">0</span>
                            </div>
                        </div>

                        <div class="divider-line"></div>

                        <div class="side-middle">

                            <div class="side-slot">
                                <div class="panel-title">ÚLTIMOS CAMBIOS DETECTADOS</div>
                                <div class="mini-viewport">
                                    <div id="lastTickets" class="mini-track">—</div>
                                </div>
                            </div>

                            <div class="divider-line"></div>

                            <div class="side-slot">
                                <div class="panel-title">ÁREAS AGOTADAS</div>
                                <div class="mini-viewport">
                                    <div id="agotadasList" class="mini-track">—</div>
                                </div>
                            </div>

                            <div class="divider-line"></div>

                            <div class="side-slot">
                                <div class="panel-title">ÁREAS CON POCAS FICHAS</div>
                                <div class="mini-viewport">
                                    <div id="pocasList" class="mini-track">—</div>
                                </div>
                            </div>

                        </div>

                        <div class="divider-line"></div>

                        <div class="side-help">
                            Consulte su servicio y tome su ficha en caja.<br />
                            Esta pantalla se actualiza automáticamente.
                        </div>

                    </aside>
                </div>

            </div>
        </div>

    </div>

    <script>
        window.dashboardDataUrl = '@Url.Action("Data", "Dashboard")';
    </script>

    <script src="@Url.Content("~/Scripts/dashboard/dashboard.js")"></script>
</body>
</html>
